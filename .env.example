# ILLUSTRATIVE PLACEHOLDERS ONLY. Not confirmed names from the original project.
# Never commit a real .env file.

# LLM for research, writing, and analysis
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_model_name_here

# Web search for trend research
SEARCH_API_KEY=your_search_api_key_here

# AI image generation
IMAGE_API_KEY=your_image_generation_key_here

# LinkedIn API (OAuth credentials; tokens must be stored securely, not in Git)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# Notifications to the owner
NOTIFY_CHANNEL=your_notification_channel_here
NOTIFY_RECIPIENT=owner@example.com

# Schedule (configured values; do not change without authorization)
TIMEZONE=your_timezone_here
POST_SCHEDULE=MON,WED,FRI@10:00
REPORT_SCHEDULE=MON@09:00

DATABASE_URL=your_database_connection_string_here
